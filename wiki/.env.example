# Copy to .env and fill in. Never commit the real .env.
APP_URL=http://localhost:6875

# Generate once:
#   docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack \
#     -c "php artisan key:generate --show"
APP_KEY=base64:CHANGE_ME

DB_ROOT_PASSWORD=change_me_root
DB_PASSWORD=change_me_app

# Shared secret between the Letwrites engine and the BookStack authz endpoint.
# Generate: openssl rand -hex 32
LETWRITES_AUTHZ_SECRET=change_me_long_random_secret
