# Automatic HTTPS for Letwrites. Caddy provisions + renews a Let's Encrypt cert for
# LETWRITES_DOMAIN as long as the domain's DNS A record points at this server and
# ports 80/443 are open.
{
	email {$LETWRITES_ACME_EMAIL}
}

{$LETWRITES_DOMAIN} {
	encode gzip
	# Self-service Confluence import service. The in-wiki page at /letwrites/import (served by
	# BookStack, signed-in only) loads the shared UI asset from here (/import/ui.js) and uploads
	# straight to /import/run — so big exports never buffer through PHP. Front with your SSO/IdP;
	# the import also requires the user's own BookStack API token, so it can't exceed their access.
	handle /import* {
		reverse_proxy letwrites_import:8088
	}
	# (Sharing is in-wiki now: the theme's /letwrites/share-* routes go to BookStack below. The old
	# standalone /share page was removed.)
	reverse_proxy bookstack:80
}

# Local testing without a public domain: set LETWRITES_DOMAIN=localhost in .env —
# Caddy will serve an internal self-signed cert on https://localhost.
