# Optional BookStack settings, passed through to the BookStack container ONLY.
# Copy to bookstack.env, uncomment what you need, then: docker compose up -d bookstack
#
# This file is deliberately separate from .env so the DB-root password and the engine
# secret (which BookStack never uses) are NOT injected into the internet-facing wiki
# container. Put ONLY BookStack's own config here. Full reference:
# https://www.bookstackapp.com/docs/admin/

# --- Single sign-on (LDAP / SAML / OIDC) — free, unmodified BookStack ---
# AUTH_METHOD=ldap
# LDAP_SERVER=ldaps://ad.yourcompany.com:636
# LDAP_BASE_DN=ou=People,dc=yourcompany,dc=com
# LDAP_DN=cn=bookstack,dc=yourcompany,dc=com
# LDAP_PASS=your-bind-password
# LDAP_USER_FILTER=(&(uid={user}))
# LDAP_ID_ATTRIBUTE=uid
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_DISPLAY_NAME_ATTRIBUTE=cn
# LDAP_VERSION=3
#   ^ REQUIRED for Google Secure LDAP and most modern LDAPS servers (they are v3-only).
#     Without it BookStack negotiates v2 and the bind fails with "ldap_bind(): Protocol error".
#
# LDAP over TLS with a CLIENT CERT (e.g. Google Secure LDAP issues a client cert + key).
# Set these as ENVIRONMENT VARIABLES (here in bookstack.env), NOT via ldap.conf:
# LDAPTLS_CERT=/config/ldap-tls/client.crt
# LDAPTLS_KEY=/config/ldap-tls/client.key
# LDAPTLS_CACERT=/config/ldap-tls/ca.crt
#   ^ libldap (what BookStack's PHP LDAP uses) IGNORES TLS_CERT/TLS_KEY when set in an ldap.conf
#     via LDAPCONF — the client cert is silently dropped and the bind fails with
#     "ldap_bind(): Invalid credentials". The client cert + key only take effect through the
#     LDAPTLS_CERT / LDAPTLS_KEY environment variables. (TLS_CACERT does work in ldap.conf, but
#     keep all three as env vars for consistency.) Verified against a live Google Secure LDAP bind.
#   IMPORTANT: BookStack runs as PUID=1000, so the cert dir + files MUST be owned by and readable
#     by uid 1000, or login fails with "Provided path [...] could not be resolved to an existing
#     location" (a permission error, not a missing file). After placing them under
#     ./data/config/ldap-tls/ run:
#       sudo chown -R 1000:1000 data/config/ldap-tls
#       chmod 700 data/config/ldap-tls
#       chmod 600 data/config/ldap-tls/client.key
#       chmod 644 data/config/ldap-tls/ca.crt data/config/ldap-tls/client.crt

# --- Email (SMTP) — needed for emailed user invites, password resets, notifications ---
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.yourcompany.com
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-smtp-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM=docs@yourcompany.com
# MAIL_FROM_NAME=Letwrites

# --- Scale & storage (only if you outgrow a single box) ---
# STORAGE_TYPE=s3
# STORAGE_S3_KEY=...
# STORAGE_S3_SECRET=...
# STORAGE_S3_BUCKET=...
# STORAGE_S3_REGION=...
# FILE_UPLOAD_SIZE_LIMIT=100
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# REDIS_SERVERS=redis:6379

# --- Interface language (BookStack ships ~30 locales) ---
# APP_LANG=en
