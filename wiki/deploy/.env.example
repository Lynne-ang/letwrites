# Copy to .env, set the two REQUIRED values, then run ./deploy.sh
# (deploy.sh auto-generates the CHANGE_ME secrets for you).

# REQUIRED — the domain Letwrites serves on (DNS A record must point here).
LETWRITES_DOMAIN=docs.yourcompany.com
# REQUIRED — email for Let's Encrypt cert notifications.
LETWRITES_ACME_EMAIL=it@yourcompany.com

TZ=UTC

# Auto-generated by deploy.sh if left as CHANGE_ME (or set your own):
APP_KEY=base64:CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
LETWRITES_AUTHZ_SECRET=CHANGE_ME
LETWRITES_ENGINE_SECRET=CHANGE_ME

# POST-SETUP — fill these AFTER first boot. Create a BookStack API token at
# Edit Profile ▸ API Tokens, then set both and run: docker compose up -d letwrites_engine
# (Leave blank for the initial deploy; the engine starts in an unconfigured state.)
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# OPTIONAL — Single sign-on (LDAP / SAML / OIDC). These pass straight through to
# BookStack (unmodified, free). Uncomment + fill, then `docker compose up -d bookstack`.
# Full reference: https://www.bookstackapp.com/docs/admin/ldap-auth/
# AUTH_METHOD=ldap
# LDAP_SERVER=ldaps://ad.yourcompany.com:636
# LDAP_BASE_DN=ou=People,dc=yourcompany,dc=com
# LDAP_DN=cn=bookstack,dc=yourcompany,dc=com
# LDAP_PASS=your-bind-password
# LDAP_USER_FILTER=(&(uid={user}))
# LDAP_ID_ATTRIBUTE=uid
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_DISPLAY_NAME_ATTRIBUTE=cn

# OPTIONAL — Email (SMTP). Needed for emailed user invites, password resets, and
# notifications. Without it, the admin creates accounts manually. Ref: bookstackapp.com/docs/admin/email-webhooks/
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.yourcompany.com
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-smtp-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM=docs@yourcompany.com
# MAIL_FROM_NAME=Letwrites

# OPTIONAL — Scale & storage (only if you outgrow a single box).
# Store uploads on S3-compatible object storage instead of local disk:
# STORAGE_TYPE=s3
# STORAGE_S3_KEY=...
# STORAGE_S3_SECRET=...
# STORAGE_S3_BUCKET=...
# STORAGE_S3_REGION=...
# Raise the upload size limit (MB):
# FILE_UPLOAD_SIZE_LIMIT=100
# Use Redis for cache/session at scale (default file/db is fine for one instance):
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# REDIS_SERVERS=redis:6379

# OPTIONAL — default interface language (BookStack ships ~30 locales).
# APP_LANG=en
