# Copy to .env, set the two REQUIRED values, then run ./deploy.sh
# (deploy.sh auto-generates the CHANGE_ME secrets for you).

# REQUIRED — the domain Letwrites serves on (DNS A record must point here).
LETWRITES_DOMAIN=docs.yourcompany.com
# REQUIRED — email for Let's Encrypt cert notifications.
LETWRITES_ACME_EMAIL=it@yourcompany.com

TZ=UTC

# Auto-generated by deploy.sh if left as CHANGE_ME (or set your own):
APP_KEY=base64:CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
LETWRITES_AUTHZ_SECRET=CHANGE_ME
LETWRITES_ENGINE_SECRET=CHANGE_ME

# POST-SETUP — fill these AFTER first boot. Create a BookStack API token at
# Edit Profile ▸ API Tokens, then set both and run: docker compose up -d letwrites_engine
# (Leave blank for the initial deploy; the engine starts in an unconfigured state.)
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# OPTIONAL BookStack settings (SSO / SMTP / object storage / locale) go in a SEPARATE
# file, bookstack.env (copy bookstack.env.example). Those pass through to the BookStack
# container only — deliberately NOT this file, so the DB-root and engine secrets above are
# never exposed to the internet-facing wiki container. See bookstack.env.example + DEPLOY.md.
